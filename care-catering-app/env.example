# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Testing Mode - Simulate user roles without authentication
# Set to 'true' to enable test mode
NEXT_PUBLIC_TEST_MODE=false

# Test User Configuration (only used when NEXT_PUBLIC_TEST_MODE=true)
# Role options: 'nurse', 'store_man', 'kitchen_staff', 'admin'
NEXT_PUBLIC_TEST_USER_ROLE=nurse

# Test User Location ID (must be a valid location ID from your database)
# This determines which location the test user is assigned to
NEXT_PUBLIC_TEST_USER_LOCATION_ID=1

# Test User ID (optional, will generate a mock UUID if not provided)
NEXT_PUBLIC_TEST_USER_ID=00000000-0000-0000-0000-000000000001

# Test User Name (optional)
NEXT_PUBLIC_TEST_USER_NAME=Test Nurse

