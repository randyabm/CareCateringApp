# ============================================
# VARIABLES REQUERIDAS (OBLIGATORIAS)
# ============================================
# Estas variables son necesarias para que la aplicación funcione correctamente

# Supabase Configuration - REQUERIDAS
# Obtén estos valores desde tu proyecto en https://supabase.com
# Ve a: Settings > API > Project URL y anon/public key
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================
# VARIABLES OPCIONALES
# ============================================

# Testing Mode - Simulate user roles without authentication
# IMPORTANTE: En producción, DEBE estar en 'false'
# Solo usar 'true' para desarrollo local y testing
# Valores válidos: 'true' o 'false' (como string)
NEXT_PUBLIC_TEST_MODE=false

# ============================================
# CONFIGURACIÓN DE MODO DE PRUEBA
# ============================================
# Las siguientes variables SOLO se usan cuando NEXT_PUBLIC_TEST_MODE=true
# NO configurar estas variables en producción
# Para más información, ver: TEST_MODE_README.md

# Test User Configuration (solo usado cuando NEXT_PUBLIC_TEST_MODE=true)
# Role options: 'nurse', 'store_man', 'kitchen_staff', 'kitchen_runner', 'admin'
NEXT_PUBLIC_TEST_USER_ROLE=nurse

# Test User Location ID (debe ser un ID válido de tu base de datos)
# Determina a qué ubicación está asignado el usuario de prueba
NEXT_PUBLIC_TEST_USER_LOCATION_ID=1

# Test User ID (opcional, se generará un UUID mock si no se proporciona)
NEXT_PUBLIC_TEST_USER_ID=00000000-0000-0000-0000-000000000001

# Test User Name (opcional, por defecto: 'Test User')
NEXT_PUBLIC_TEST_USER_NAME=Test Nurse

